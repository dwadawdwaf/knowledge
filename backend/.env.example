# 复制为 .env 后按需修改；.env 不入库。
# 未配置模型端点时使用本地哈希向量与桩生成，可跑通链路但不代表检索质量。
# 根目录 start.cmd 默认真实模式，要求两个端点均配置；start.cmd -Mode Demo 才使用本地桩。

# 数据库：注释掉本行时，start.cmd 与浏览器验收每次创建临时库；显式填写则改用该库并只做迁移。
# 远端库请先建隧道（ssh -N -L 5433:127.0.0.1:5432 root@<server>），不要暴露公网 5432。
# 该库需已启用 vector 与 pg_trgm 扩展（超级用户创建一次）。细则见 docs/runbook.md §15。
# KS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/knowledge
# 浏览器验收专用库（桩模型 hash-1024），与上面的 KS_DATABASE_URL 不能是同一个库；留空则用临时库。
# KS_SMOKE_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ks_smoke
KS_STORAGE_ROOT=./.data/objects
KS_TOKEN_SECRET=dev-only-secret
KS_TOKEN_TTL_SECONDS=86400

# 留空则使用 HashEmbedder（1024 维，确定性）
# 在线：SiliconFlow BGE-M3（1024 维，免费额度）；智谱 embedding-3 需加 KS_EMBEDDING_DIMENSIONS=1024
# 离线预留：Ollama（http://localhost:11434/v1 + bge-m3），本机代理环境先设 NO_PROXY=127.0.0.1,localhost
KS_EMBEDDING_BASE_URL=
KS_EMBEDDING_MODEL=BAAI/bge-m3
KS_EMBEDDING_DIM=1024
KS_EMBEDDING_API_KEY=
# 端点要求显式指定维度时设置（如 embedding-3 系列）；留空不下发
KS_EMBEDDING_DIMENSIONS=

# 留空则使用 StubGenerator；在线示例：DeepSeek（https://api.deepseek.com + deepseek-chat）
KS_GENERATOR_BASE_URL=
KS_GENERATOR_MODEL=deepseek-chat
KS_GENERATOR_API_KEY=
KS_GENERATOR_TIMEOUT_SECONDS=60

KS_MAX_UPLOAD_BYTES=52428800
KS_TOP_K_DEFAULT=5
KS_TOP_K_MAX=20
KS_SIMILARITY_FLOOR=0.06
# 余弦距离上限，超过视为不相关；换真实向量模型后必须重新标定
KS_SEMANTIC_MAX_DISTANCE=0.85
KS_EVIDENCE_MIN_SCORE=0.0
KS_EVIDENCE_MAX_ITEMS=6

KS_LEASE_SECONDS=120
KS_HEARTBEAT_SECONDS=30
KS_MAX_ATTEMPTS=3
KS_WORKER_POLL_SECONDS=1.0

KS_CHUNK_MAX_CHARS=800
KS_CHUNK_OVERLAP_CHARS=100
